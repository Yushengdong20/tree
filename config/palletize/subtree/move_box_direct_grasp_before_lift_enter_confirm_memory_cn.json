        "params": {
          "target_type": {
            "value": "claw_point",
            "source": "CUSTOM"
          },
          "pose_frame": {
            "value": "base_link",
            "source": "CUSTOM"
          },
          "left_point_key": {
            "value": "move_box_direct_left_below_edge",
            "source": "CUSTOM"
          },
          "right_point_key": {
            "value": "move_box_direct_right_below_edge",
            "source": "CUSTOM"
