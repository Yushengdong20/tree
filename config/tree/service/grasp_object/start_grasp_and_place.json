          "left_key": {
            "value": "grasp_and_place_done_count",
            "source": "CUSTOM"
          },
          "operator": {
            "value": ">=",
            "source": "CUSTOM"
          },
          "right_key": {
            "value": "grasp_and_place_target_count",
            "source": "CUSTOM"
          }
        },
        "childs": [
          {
            "name": "Sequence",
            "label": "grasp_and_place 单轮抓放流程",
            "params": {
              "memory": {
                "value": "True",
                "source": "CUSTOM"
              }
            },
            "childs": [
              {
                "name": "ArmsToPose",
                "label": "前往A点前双臂返回初始位姿",
