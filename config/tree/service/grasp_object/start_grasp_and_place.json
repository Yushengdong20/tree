{
  "tree": {
    "name": "Sequence",
    "label": "HTTP grasp_and_place 单次任务流程",
    "params": {
      "memory": {
        "value": "True",
        "source": "CUSTOM"
      }
    },
    "childs": [
      {
        "name": "EnsureGraspObjectServices",
        "label": "创建抓取任务共享服务",
        "params": {},
        "childs": []
      },
      {
        "name": "OpenClaw",
        "label": "启动时张开双夹爪",
        "params": {
          "side": {
            "value": "both",
            "source": "CUSTOM"
          }
        },
        "childs": []
      },
      {
        "name": "MoveBoxHeadToPose",
        "label": "启动时头部下俯20度",
        "params": {
          "yaw": {
            "value": "0.0",
            "source": "CUSTOM"
          },
          "pitch": {
            "value": "20.0",
            "source": "CUSTOM"
          }
        },
        "childs": []
      },
      {
        "name": "MoveTorsoPose",
        "label": "启动时腰部回到预备位姿",
