                          "place_plane_height_key": {
                            "value": "grasp_object_height_place_plane",
                            "source": "CUSTOM"
                          },
                          "place_plane_frame": {
                            "value": "base_link",
                            "source": "CUSTOM"
                          },
                          "place_torso_height_offset": {
                            "value": "0.4",
                            "source": "CUSTOM"
                          },
                          "place_torso_min_height": {
                            "value": "0.6",
                            "source": "CUSTOM"
                          },
                          "place_torso_max_height": {
                            "value": "1.4",
                            "source": "CUSTOM"
                          },
                          "place_torso_x": {
                            "value": "0.3",
                            "source": "CUSTOM"
                          },
                          "target_pose_key": {
                            "value": "grasp_object_place_torso_pose",
                            "source": "CUSTOM"
                          }
