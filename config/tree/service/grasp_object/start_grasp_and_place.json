                      "chassis_url": {
                        "value": "http://localhost:8081",
                        "source": "CUSTOM"
                      },
                      "navigation_timeout_sec": {
                        "value": "600",
                        "source": "CUSTOM"
                      },
                      "poll_interval_sec": {
                        "value": "0.2",
                        "source": "CUSTOM"
                      },
                      "navigation_target_key": {
                        "value": "grasp_object_place_navigation_target_runtime",
                        "source": "CUSTOM"
                      }
                    },
                    "childs": []
                  },
