            "params": {
              "pose_frame": {
                "value": "waist_yaw_link",
                "source": "CUSTOM"
              },
              "left_pose": {
                "value": "[0.301, 0.3, 0.2, 0.0, -100.0, 0.0]",
                "source": "CUSTOM"
              },
              "right_pose": {
                "value": "[0.301, -0.3, 0.2, 0.0, -100.0, 0.0]",
                "source": "CUSTOM"
              }
            },
            "childs": []
          },
          {
            "name": "MoveTorsoPose",
            "label": "任务完成后腰部回到预备位姿",
