              "pose": {
                "value": "[0.1, 0.000, 0.926, 0.0, 0.0, 0.0]",
                "source": "CUSTOM"
              },
              "wait_done": {
                "value": "True",
                "source": "CUSTOM"
              }
            },
            "childs": []
          }
        ]
      }
    ]
  }
