                          "key": {
                            "value": "grasp_and_place_done_count",
                            "source": "CUSTOM"
                          },
                          "step": {
                            "value": "2",
                            "source": "CUSTOM"
                          },
                          "default_value": {
                            "value": "0",
                            "source": "CUSTOM"
                          }
                        },
                        "childs": []
                      }
                    ]
                  },
                  {
                    "name": "IncrementBlackboardValue",
                    "label": "单抓完成数量加一",
                    "params": {
                      "key": {
                        "value": "grasp_and_place_done_count",
                        "source": "CUSTOM"
                      },
                      "step": {
                        "value": "1",
                        "source": "CUSTOM"
                      },
                      "default_value": {
                        "value": "0",
                        "source": "CUSTOM"
                      }
                    },
                    "childs": []
                  }
                ]
              }
            ]
