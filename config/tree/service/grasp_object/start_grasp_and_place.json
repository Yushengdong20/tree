                          },
                          "place_torso_height_offset": {
                            "value": "0.0",
                            "source": "CUSTOM"
                          },
                          "place_torso_min_height": {
                            "value": "0.6",
                            "source": "CUSTOM"
                          },
                          "place_torso_max_height": {
                            "value": "1.4",
                            "source": "CUSTOM"
                          },
                          "place_torso_x": {
                            "value": "0.117",
                            "source": "CUSTOM"
                          },
